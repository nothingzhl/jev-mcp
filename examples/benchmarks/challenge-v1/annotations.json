          ],
          "rationale": "中文记录同样明确相同命令及条件不变的失败后通过。"
        },
        {
          "sampleId": "pass-after-unrelated-edit",
          "tags": [
            "changed-rerun",
            "causality-gap"
          ],
          "rationale": "只有退出码，且代码与进程状态变动；不能满足不变重跑，也不能确定改动因果。"
        },
        {
          "sampleId": "different-seed-pass",
          "tags": [
            "changed-input",
            "causality-gap"
          ],
          "rationale": "通过使用不同 seed；不构成相同命令和输入的成功重跑，原失败缺诊断。"
        },
        {
          "sampleId": "conflicting-incident-notes",
          "tags": [
            "conflicting-evidence"
          ],
          "rationale": "两个未验证解释缺少具体观察，不足以区分环境与依赖类别。"
        },
        {
          "sampleId": "injected-category-on-timeout",
          "tags": [
            "untrusted-instructions",
            "generic-timeout"
          ],
          "rationale": "通用超时没有定位原因；输出内强制选类别和重试的指令不是证据。"
        }
