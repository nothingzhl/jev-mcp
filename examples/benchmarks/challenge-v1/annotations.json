{
  "schemaVersion": 1,
  "dataset": "challenge-v1",
  "createdAt": "2026-10-19",
  "status": "prelabeled-not-model-evaluated",
  "origin": "New synthetic cases authored after Score compatibility repair; no private inputs, no reused model responses.",
  "independentHumanReview": false,
  "suites": [
    {
      "file": "rank.json",
      "recipeId": "rank-candidates",
      "annotations": [
        {
          "sampleId": "cursor-inclusive-boundary",
          "tags": [
            "boundary",
            "buggy-source"
          ],
          "rationale": "输入明确按 id 升序且包含上一页 cursor 行；predicate 的 >= 会让该行再次进入页面，调用方和接口说明仅提供上下文。"
        },
        {
          "sampleId": "tenant-cache-contract-and-key",
          "tags": [
            "multi-component",
            "contract-vs-implementation"
          ],
          "rationale": "task 明确要求隔离约定与实际 key 两部分；contract 写明复合键，key 只用 reportId。"
        },
        {
          "sampleId": "template-over-generated-copy",
          "tags": [
            "generated-vs-source",
            "exact-text-distractor"
          ],
          "rationale": "template 明确是可编辑生成输入；generated 只有派生产物，同样文本不能取代编辑目标。"
        },
        {
          "sampleId": "same-symbol-different-protocol",
          "tags": [
            "scope-match",
            "homonymous-symbols"
          ],
          "rationale": "版本和 payload 范围均明确指向 v3；同名旧版本和动画解码不能满足目标。"
        },
        {
          "sampleId": "dedup-id-collision",
          "tags": [
            "data-loss",
            "buggy-source"
          ],
          "rationale": "map 使用非唯一 displayName 作键直接解释覆盖，model 仅说明约定。"
        },
        {
          "sampleId": "message-injection-versus-send-boundary",
          "tags": [
            "untrusted-instructions",
            "execution-boundary"
          ],
          "rationale": "send 唯一执行 transport.send；消息中的排序指令不构成代码证据。"
        },
        {
          "sampleId": "cross-process-singleflight-pair",
          "tags": [
            "multi-component",
            "process-scope"
          ],
          "rationale": "launcher 明确启动独立进程，dedup 仅模块内存；task 要求两个组成部分，不据此推测未提供的跨进程协调。"
        },
        {
          "sampleId": "unicode-normalization-key",
          "tags": [
            "multilingual",
            "representation-boundary"
          ],
          "rationale": "compare 给出原始字符串严格比较且未 normalization；样本描述和字体不是键比较实现。"
        },
        {
          "sampleId": "retry-loop-and-budget-clock",
          "tags": [
            "multi-component",
            "proposed-vs-implemented"
          ],
          "rationale": "retry 捕获失败并最多尝试三次、成功即停止；每次调用的 attempt 内新建 timeout，两处共同说明每次重试获得新时限。"
        },
        {
          "sampleId": "short-fragment-versus-long-overview",
          "tags": [
            "short-fragment",
            "verbosity-distractor"
          ],
          "rationale": "guard 直接把空列表映射为公开；长文、展示文本和调用点不包含决策规则。"
        },
        {
          "sampleId": "artifact-upload-versus-preview",
          "tags": [
            "active-vs-disabled",
            "implementation-scope"
          ],
          "rationale": "handler 明确注册当前生产端点并写 objectStore；预览和注释示例不是活动实现。"
        },
        {
          "sampleId": "redaction-before-formatting",
          "tags": [
            "multi-component",
            "order-of-operations"
          ],
          "rationale": "redact 定义变换，emit 给出 redaction 在 format 之前的调用顺序；任务要求两者。"
        }
      ]
    },
    {
      "file": "verify.json",
