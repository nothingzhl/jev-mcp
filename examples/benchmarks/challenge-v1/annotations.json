          ],
          "rationale": "green 的证据直接匹配；blue 自己的记录明确否定目标 digest，不能借用 green 的证据。"
        },
        {
          "sampleId": "copy-started-not-completed",
          "tags": [
            "intermediate-step",
            "compound-claim"
          ],
          "rationale": "开始传输未证明复制完成，更未证明远端校验完成。"
        },
        {
          "sampleId": "matching-name-wrong-region",
          "tags": [
            "entity-scope",
            "region-mismatch"
          ],
          "rationale": "同名但区域不同，us-east 成功不能建立 eu-west 的完成声明。"
        },
        {
          "sampleId": "mocked-port-is-not-network",
          "tags": [
            "mock-vs-real",
            "execution-scope"
          ],
          "rationale": "证据明确说完全内存 Fake 且没有真实网络测试，直接否定已建立真实连接。"
        },
        {
          "sampleId": "stale-window-is-not-current",
          "tags": [
            "time-scope"
          ],
          "rationale": "记录的时间窗口不同，不能借历史成功证明当前运行。"
        },
        {
          "sampleId": "sample-is-not-universal",
          "tags": [
            "quantifier",
            "partial-evidence"
          ],
          "rationale": "抽查五条不能建立全称声明；未检查行没有正反证据。"
        },
        {
          "sampleId": "narrow-and-broad-coverage",
          "tags": [
            "batched",
            "compound-claim"
          ],
          "rationale": "narrow 范围与自身证据相同；broad 缺 renderer 部分，不能完整支持。"
        },
        {
          "sampleId": "sibling-evidence-isolation",
          "tags": [
            "batched",
            "missing-evidence",
            "cross-claim-isolation"
          ],
          "rationale": "cache 有自身健康记录；search 的分区清单没有健康观察，不允许借用同批 cache 证据；queue 的空证据另行触发强制 review。"
        },
        {
          "sampleId": "completed-then-undone",
          "tags": [
            "batched",
            "temporal-order"
          ],
          "rationale": "current 与最后 disabled 直接矛盾；history 仅声称曾完成 enable，记录直接支持。"
        },
        {
          "sampleId": "empty-file-is-not-complete-data",
          "tags": [
            "success-status-vs-content"
          ],
          "rationale": "退出码不能覆盖内容记录；数据明确为空且缺必需交易行，直接矛盾。"
        },
        {
          "sampleId": "truncated-proof",
          "tags": [
            "multilingual",
            "truncated-evidence",
            "compound-claim"
          ],
          "rationale": "上传完成仅为中间步骤，日志截断不能证明发布及健康检查完成。"
        },
        {
          "sampleId": "instructions-without-observation",
          "tags": [
            "untrusted-instructions",
            "intent-only"
          ],
          "rationale": "要求支持的文字不是执行证据；只有请求且没有执行状态，不能证明完成。"
        }
      ]
    },
