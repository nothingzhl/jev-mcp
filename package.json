{
  "name": "@nothingzhl/jev-mcp",
  "version": "0.1.0",
  "files": [
    "dist",
    "README.md",
    "docs/codex-quickstart.md",
    "examples/codex-config.toml",
    "docs/npm-publishing.md",
    "examples/rank-candidates.json",
    "examples/verify-claims.json",
    "examples/triage-failure.json"
  ],
  "description": "Versioned TypeSafe Jev judgments for Codex via a local MCP server and CLI",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "jev": "dist/cli.js",
    "jev-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "setup:codex": "node scripts/setup-codex.mjs",
    "prepack": "npm run build",
    "pack:local": "node -e \"require('node:fs').mkdirSync('.data', { recursive: true })\" && npm pack --pack-destination .data",
    "demo": "tsx src/cli.ts run rank-candidates --input examples/rank-candidates.json --dry-run",
    "prepublishOnly": "npm run check && npm run demo",
    "release:check": "npm publish --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@typesafe-ai/sdk": "0.7.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nothingzhl/jev-mcp.git"
  },
  "homepage": "https://github.com/nothingzhl/jev-mcp#readme",
  "bugs": {
    "url": "https://github.com/nothingzhl/jev-mcp/issues"
  },
  "keywords": [
    "mcp",
    "codex",
    "jev",
    "typesafe",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
